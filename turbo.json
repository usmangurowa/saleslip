{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalEnv": [
    "SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "EXPO_PUBLIC_SENTRY_DSN",
    "POSTHOG_API_KEY",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "EXPO_PUBLIC_POSTHOG_KEY",
    "POSTGRES_URL",
    "SERVER_PORT",
    "SERVER_URL",
    "APP_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_PORT",
    "AUTH_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "SUPABASE_JWT_SECRET",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "SUPPORT_INBOX_EMAIL",
    "TRIGGER_SECRET_KEY",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY",
    "EXPO_PUBLIC_API_URL",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "OPENROUTER_API_KEY",
    "GROQ_API_KEY",
    "PUBLIC_BASE_URL",
    "BRAND_NAME",
    "SUPPORT_PHONE",
    "ROUTER_HOST",
    "ROUTER_PORT",
    "ROUTER_API_USER",
    "ROUTER_API_PASSWORD",
    "ROUTER_DISABLED",
    "PAYSTACK_SECRET_KEY",
    "PAYSTACK_PUBLIC_KEY",
    "PAYSTACK_DISABLED",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_WEBHOOK_SECRET",
    "TELEGRAM_ADMIN_IDS",
    "WIFI_PROFILE_DAY_1",
    "WIFI_PROFILE_DAY_2",
    "WIFI_PROFILE_WEEK_1",
    "WIFI_PROFILE_WEEK_2",
    "WIFI_PROFILE_MONTH_1",
    "WIFI_PROFILE_MONTH_2",
    "ADMIN_EMAILS",
    "WG_GATEWAY_HOST",
    "WIFI_HOTSPOT_SERVER"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event",
    "npm_package_version",
    "PORT",
    "SKIP_ENV_VALIDATION"
  ]
}
