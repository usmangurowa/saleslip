# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.
# Prefer a secrets manager? See "Optional — Infisical" in the README: `pnpm dev:infisical`
# injects secrets at runtime and anything missing still falls back to this file.
# Machine-identity credentials for scripts/infisical-run.sh (production containers set
# these on the platform; locally they are optional — an `infisical login` session works too):
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=   # or commit .infisical.json via `pnpm exec infisical init`
# INFISICAL_ENV=dev

# Non-secret constants (PostHog host, Expo app identity, provider API URLs) are
# hardcoded in the codebase — see apps/mobile/app.config.ts and eas.json.

# Database
POSTGRES_URL=''

# App URLs / ports
SERVER_PORT='3001'
# Web: where the console proxy forwards '/api/wifi-router/*' — the only origin
# with a WireGuard route to the hotspot.
SERVER_URL='http://localhost:3001'
APP_URL='http://localhost:3000'
NEXT_PUBLIC_PORT='3000'
NEXT_PUBLIC_APP_URL='http://localhost:3000'
EXPO_PUBLIC_API_URL='http://localhost:3000'

# Better Auth
# Generate the secret via 'openssl rand -base64 32'
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET=''
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''

# Supabase
# @see https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=''
NEXT_PUBLIC_SUPABASE_ANON_KEY=''
EXPO_PUBLIC_SUPABASE_URL=''
EXPO_PUBLIC_SUPABASE_ANON_KEY=''
SUPABASE_JWT_SECRET=''

# Resend (email sending)
RESEND_API_KEY=''
# Sender address for outbound email (must be on a domain verified in Resend)
MAIL_FROM='Saleslip <no-reply@saleslip.app>'

# Support inbox (optional — defaults to the mail package's DEFAULT_FROM)
SUPPORT_INBOX_EMAIL=''

# Trigger.dev (optional — when set, support emails are sent via background job)
TRIGGER_SECRET_KEY=''

# PostHog Analytics (keys only — host is hardcoded)
# @see https://posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=''
POSTHOG_API_KEY=''
EXPO_PUBLIC_POSTHOG_KEY=''

# Sentry Error Tracking
SENTRY_DSN=''
NEXT_PUBLIC_SENTRY_DSN=''
EXPO_PUBLIC_SENTRY_DSN=''

# AI Providers
GOOGLE_GENERATIVE_AI_API_KEY=''
OPENROUTER_API_KEY=''
GROQ_API_KEY=''

# WiFi voucher shop (apps/server) — all optional; the shop degrades to
# "not configured" responses when Paystack or the router is missing.
# Public origin the buyer reaches us on (Paystack callback + Telegram links).
PUBLIC_BASE_URL='https://wifi.saleslip.app'
BRAND_NAME='Saleslip Starlink'
SUPPORT_PHONE=''

# MikroTik RouterOS API, reached over the WireGuard tunnel from the VPS.
ROUTER_HOST='10.8.0.2'
ROUTER_PORT='8728'
ROUTER_API_USER=''
ROUTER_API_PASSWORD=''
# Set to 1 to skip router calls (orders park in pending_router).
ROUTER_DISABLED=''
# Hotspot user-profile names as created on the router (defaults shown).
# Read by BOTH runtimes: apps/server fulfils orders against them, and the web
# dashboard's WiFi console mints counter batches against them. If they drift
# apart, counter codes reference profiles the router does not have.
WIFI_PROFILE_DAY_1='Saleslip-1d-1'
WIFI_PROFILE_DAY_2='Saleslip-1d-2'
WIFI_PROFILE_WEEK_1='Saleslip-7d-1'
WIFI_PROFILE_WEEK_2='Saleslip-7d-2'
WIFI_PROFILE_MONTH_1='Saleslip-30d-1'
WIFI_PROFILE_MONTH_2='Saleslip-30d-2'
# Comma-separated admin emails allowed to sign in to the dashboard.
ADMIN_EMAILS=''
# Hotspot server name on routers running more than one (per-area setup).
# Leave blank on a single-server router; blank means "all".
WIFI_HOTSPOT_SERVER=''

# Paystack — secret key signs webhooks and calls the API.
PAYSTACK_SECRET_KEY=''
PAYSTACK_PUBLIC_KEY=''
PAYSTACK_DISABLED=''

# Telegram bot (webhook mode). TELEGRAM_ADMIN_IDS is comma-separated user IDs.
TELEGRAM_BOT_TOKEN=''
TELEGRAM_WEBHOOK_SECRET=''
TELEGRAM_ADMIN_IDS=''

# Container-only: docker service name of wg-easy; the entrypoint routes
# 10.8.0.0/24 through it. Unused for local dev.
WG_GATEWAY_HOST='wg-easy'
